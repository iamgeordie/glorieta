# Accounts are off unless both Supabase values are set. Copy to .env.local to try them.
# These two are public by design (they ship in the browser); row level security is the protection.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to true only after the Google provider is configured in Supabase.
VITE_GOOGLE_AUTH_ENABLED=

# Podograph brand id for Carnet. Opted-in users are sent to the CRM only when this is set.
VITE_PODOGRAPH_BRAND_ID=
