{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carnet",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "routes": [{ "pattern": "carnet.anaidic.com", "custom_domain": true }],
  // One canonical URL: the custom domain. workers.dev and preview URLs stay off.
  "workers_dev": false,
  "preview_urls": false
}
